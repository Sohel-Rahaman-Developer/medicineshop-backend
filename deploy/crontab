# crontab -u medshop deploy/crontab   (server clock is Asia/Kolkata)
# Every night at 2:30: encrypted backup, newest 14 kept
30 2 * * * cd /srv/medshop/backend && npm run backup >> /srv/medshop/backups/backup.log 2>&1
# 1st of every month at 4:00: restore the newest backup into a scratch DB and compare (SECURITY §5)
0 4 1 * * cd /srv/medshop/backend && npm run backup:verify >> /srv/medshop/backups/verify.log 2>&1
