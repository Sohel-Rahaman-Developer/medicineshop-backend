# Production backend env → <MEDSHOP_ROOT>/backend/.env (chmod 600). Never commit the filled copy.
# Secrets: openssl rand -hex 32   (a different one for each line that says so)

NODE_ENV=production
PORT=5300
API_PREFIX=/api/v1
SHOP_APP_URL=https://medbox24.in
ADMIN_APP_URL=https://admin.medbox24.in

# Atlas (Mumbai, ap-south-1): Database → Connect → Drivers. Name the database in the path.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/medicineshop?retryWrites=true&w=majority

# openssl rand -hex 32 — each of these three different
JWT_ACCESS_SECRET=
CSRF_SECRET=
ADMIN_TOTP_KEY=

COOKIE_SECURE=true
COOKIE_SAMESITE=lax

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@medbox24.in
SMTP_PASS=
MAIL_FROM_NAME=MedBox24
MAIL_FROM_EMAIL=no-reply@medbox24.in

# Razorpay test keys run here as a rehearsal; live keys (rzp_live_) also need BILLING_GSTIN + BILLING_ADDRESS.
# Webhook URL in the Razorpay dashboard: https://api.medbox24.in/api/v1/webhooks/razorpay
PAYMENTS_MODE=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

BILLING_LEGAL_NAME=
BILLING_ADDRESS=
BILLING_STATE=West Bengal
BILLING_GSTIN=
BILLING_SAC=998314

# npm run backup (cron) — keep BACKUP_KEY somewhere safe off this server too, or the backups can't be opened
BACKUP_DIR=/home/deploy/test/pharma/backups
BACKUP_KEEP=14
BACKUP_KEY=

LOG_LEVEL=info
