# ============================================================================
# Medicine Shop — Backend environment
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Never put real credentials in this file — it is committed to git.
# ============================================================================

# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# The only browser origins allowed to call the API (CORS + CSRF origin check)
SHOP_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001

# ─── Database ───────────────────────────────────────────────────────────────
# IMPORTANT: a POS sale deducts stock inside a transaction, and MongoDB
# transactions require a replica set. Atlas provides one by default; a local
# standalone mongod does NOT, and transactions will fail there.
MONGODB_URI=mongodb://127.0.0.1:27017/medicineshop

# ─── Auth: access token (JWT, short lived) ──────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_ACCESS_TTL=15m

# ─── Auth: refresh token (opaque, stored hashed) ────────────────────────────
# "Remember me" ON  -> REFRESH_TTL_DAYS_REMEMBER (long session)
# "Remember me" OFF -> REFRESH_TTL_DAYS
REFRESH_TTL_DAYS=7
REFRESH_TTL_DAYS_REMEMBER=90

# Both tokens live only in httpOnly cookies (host-only, no Domain attribute).
# COOKIE_SECURE must be true in production (HTTPS) — the server refuses to start otherwise.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# HMAC key for CSRF tokens — different from JWT_ACCESS_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CSRF_SECRET=replace_me_with_another_long_random_string

# ─── Email OTP login ────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ─── Rate limiting ──────────────────────────────────────────────────────────
# RULE: no limit is ever global. Every limit is keyed by user, email or IP, so
# one person flooding the API can never lock everybody else out.
#
# The IP limits are deliberately loose: a shop runs several terminals behind one
# router, and mobile carriers put thousands of people behind a single CGNAT
# address. Strict per-IP limits would block real customers.
RATE_WINDOW_MINUTES=15

# Per EMAIL — stops OTP mail bombing of someone's inbox
RATE_OTP_REQUEST_PER_EMAIL=3
# Per IP — only to stop mass enumeration, hence loose
RATE_OTP_REQUEST_PER_IP=60
# Per EMAIL — second wall against brute force (first is OTP_MAX_ATTEMPTS)
RATE_OTP_VERIFY_PER_EMAIL=15
# Per USER when signed in, otherwise per IP
RATE_REFRESH_PER_USER=120

# Default for protected API routes — per user, per MINUTE
RATE_API_PER_USER_PER_MIN=300

# ─── SMTP (OTP mail, alerts, optional bill email) ───────────────────────────
# For Gmail you must create an App Password — the normal password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Medicine Shop
MAIL_FROM_EMAIL=no-reply@example.com

# ─── Razorpay (SaaS subscription billing — Phase 9) ─────────────────────────
# This is NOT for the shop's POS payments, only for our own subscription.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
