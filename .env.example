# ============================================================================
# Medicine Shop — Backend environment
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Kabhi bhi real creds is file me mat likhna — ye example git me jaata hai.
# ============================================================================

# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Frontend ka URL — CORS aur email links ke liye. Comma se multiple de sakte ho.
APP_WEB_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ─── Database ───────────────────────────────────────────────────────────────
# IMPORTANT: POS sale + stock deduct ek transaction me hota hai, aur MongoDB
# transactions ke liye replica set chahiye. Atlas me by default milta hai;
# local standalone mongod par transaction FAIL karega.
MONGODB_URI=mongodb://127.0.0.1:27017/medicineshop

# ─── Auth: access token (JWT, short-lived) ──────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_ACCESS_TTL=15m

# ─── Auth: refresh token (opaque, DB me hashed store hota hai) ──────────────
# "Remember me" ON  -> REFRESH_TTL_DAYS_REMEMBER chalega (lamba session)
# "Remember me" OFF -> REFRESH_TTL_DAYS chalega
REFRESH_TTL_DAYS=7
REFRESH_TTL_DAYS_REMEMBER=90

# Refresh token web par httpOnly cookie me jaata hai.
# Production me COOKIE_SECURE=true (HTTPS) aur COOKIE_DOMAIN apna domain.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ─── Email OTP login ────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ─── SMTP (OTP mail, alerts, optional bill email) ───────────────────────────
# Gmail use kar rahe ho to App Password banana padega (normal password nahi chalega)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Medicine Shop
MAIL_FROM_EMAIL=no-reply@example.com

# ─── Razorpay (SaaS subscription billing — Phase 9) ─────────────────────────
# Ye shop ke POS payments ke liye NAHI hai, sirf hamari subscription ke liye.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
